{
  "trailingSlash": false,
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/host", "destination": "/host.html" },
    { "source": "/host/:path*", "destination": "/host.html" },
    { "source": "/e/:id", "destination": "/event.html" },
    { "source": "/r/:id", "destination": "/replay2.html" },
    { "source": "/r2/:id", "destination": "/replay2.html" },
    { "source": "/r1/:id", "destination": "/replay.html" },
    { "source": "/s/:id", "destination": "/stage.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
