{
  "manifest_version": 3,
  "name": "Sitca",
  "version": "0.1.2",
  "description": "Sitca sits beside your Google Meet, Zoom, Teams or YouTube session: live captions, private answers, notes, and a recap to share.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Sitca"
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "tabCapture",
    "activeTab",
    "storage",
    "identity",
    "contextMenus",
    "tabs",
    "offscreen",
    "alarms"
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://sitcaai.vercel.app/*",
    "https://jadukkvulkxnttowxefu.supabase.co/*",
    "https://*.r2.cloudflarestorage.com/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.youtube.com/*",
    "https://*.webex.com/*",
    "https://*.whereby.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/wc/*",
        "https://*.zoom.us/j/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.youtube.com/*",
        "https://*.webex.com/*",
        "https://*.whereby.com/*"
      ],
      "js": [
        "meet.js"
      ],
      "css": [
        "meet.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "meet.css"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.youtube.com/*",
        "https://*.webex.com/*",
        "https://*.whereby.com/*"
      ]
    }
  ],
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Sitca: capture this meeting"
    }
  },
  "key": ""
}
